# Included from the http context via /etc/nginx/sites-enabled/.
# These limits are global for this single-user workspace. Do not trust
# client-supplied forwarded IP headers when proxying through Vercel.
limit_req_zone $server_name zone=job_tracker_api:10m rate=120r/m;
limit_req_zone $server_name zone=job_tracker_ai:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.example.com;
    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "Job Tracker";
    auth_basic_user_file /etc/nginx/job-tracker.htpasswd;
    client_max_body_size 100k;
    limit_req_status 429;
    add_header Cache-Control "private, no-store" always;
    add_header CDN-Cache-Control "no-store" always;
    add_header Vercel-CDN-Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Return JSON without a browser-native Basic Auth dialog.
    error_page 401 = @unauthorized;
    location @unauthorized {
        auth_basic off;
        default_type application/json;
        return 401 '{"error":"Sign in required."}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 40s;
    proxy_send_timeout 40s;
    proxy_hide_header Cache-Control;
    proxy_hide_header CDN-Cache-Control;
    proxy_hide_header Vercel-CDN-Cache-Control;

    location = /ai/parse-job {
        limit_req zone=job_tracker_ai burst=2 nodelay;
        proxy_pass http://localhost:3000;
    }

    location / {
        limit_req zone=job_tracker_api burst=20 nodelay;
        proxy_pass http://localhost:3000;
    }
}
